{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmx-explain.local/schema/pmetrics-artifact-v1.schema.json",
  "title": "PMx Explain Pmetrics artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "engine", "label", "administration", "structure", "error", "supportPoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$" },
    "engine": { "const": "Pmetrics" },
    "label": { "type": "string", "minLength": 1 },
    "labelEn": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "description": { "type": "string" },
    "descriptionEn": { "type": "string" },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "mode"],
      "properties": {
        "route": { "enum": ["IV", "Oral", "IM"] },
        "mode": { "enum": ["IV_INTERMITTENT", "IV_CONTINUOUS", "ORAL", "IM"] }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "parameters"],
      "properties": {
        "template": { "enum": ["one_compartment_iv", "one_compartment_oral", "two_compartment_iv"] },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lower", "upper"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
              "lower": { "type": "number" },
              "upper": { "type": "number" }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "initial", "coefficients", "fixed"],
      "properties": {
        "type": { "enum": ["proportional", "additive"] },
        "initial": { "type": "number", "exclusiveMinimum": 0 },
        "coefficients": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "fixed": { "type": "boolean" }
      }
    },
    "supportPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prob"],
        "properties": { "prob": { "type": "number", "exclusiveMinimum": 0 } },
        "additionalProperties": { "type": "number" }
      }
    }
  }
}
